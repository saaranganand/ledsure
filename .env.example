# copy to .env and adjust

# address the HTTP server listens on
LEDSURE_ADDR=:8080

# postgres connection string (pgx)
LEDSURE_DATABASE_URL=postgres://ledsure:ledsure@localhost:5432/ledsure?sslmode=disable

# run goose migrations automatically on startup
LEDSURE_MIGRATE_ON_START=true

# log level: debug, info, warn, error
LEDSURE_LOG_LEVEL=info
